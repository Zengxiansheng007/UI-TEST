{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ui-test/schemas/pytest-session-result.v2.json",
  "title": "Pytest Session Result V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "execution_origin",
    "origin_evidence_digest",
    "nodes",
    "pytest_exitstatus",
    "all_required_nodes_committed",
    "session_status",
    "recorded_at",
    "session_result_hash",
    "expected_nodes"
  ],
  "properties": {
    "batch_id": {"$ref": "#/$defs/stableIdentity"},
    "denied_duplicate_nodes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "collection_consistent": {"type": "boolean"},
    "unexpected_nodes": {"type": "array", "items": {"type": "string"}},
    "worker_errors": {"type": "array", "items": {"type": "string"}},
    "schema_version": {
      "const": "ui-test.pytest-session-result.v2"
    },
    "session_id": {
      "$ref": "#/$defs/stableIdentity"
    },
    "execution_origin": {
      "enum": [
        "pycharm",
        "codex-cli",
        "cli",
        "ci",
        "unknown"
      ]
    },
    "origin_evidence_digest": {
      "$ref": "#/$defs/hash"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nodeResult"
      }
    },
    "pytest_exitstatus": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "all_required_nodes_committed": {
      "type": "boolean"
    },
    "session_status": {
      "enum": [
        "passed",
        "failed",
        "interrupted"
      ]
    },
    "selected_cases": {
      "type": "object", "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": {"case_id":{"type":"string","minLength":1},"branch_id":{"type":"string","minLength":1}}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "session_result_hash": {
      "$ref": "#/$defs/hash"
    },
    "expected_nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "session_status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "denied_duplicate_nodes": {"maxItems": 0},
          "pytest_exitstatus": {
            "const": 0
          },
          "all_required_nodes_committed": {
            "const": true
          },
          "nodes": {
            "items": {
              "properties": {
                "finalization_status": {
                  "enum": [
                    "committed",
                    "not_applicable_qualification",
                    "not_applicable_read_only"
                  ]
                },
                "disposition": {
                  "const": "passed"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stableIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "relativeRef": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^(?:[A-Za-z]:|/|\\\\)"
          },
          {
            "pattern": "(?:^|/)\\.\\.(?:/|$)"
          }
        ]
      }
    },
    "nodeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "finalization_status",
        "disposition"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/stableIdentity"
        },
        "attempt_ref": {"$ref": "#/$defs/relativeRef"},
        "node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "terminal_ref": {
          "$ref": "#/$defs/relativeRef"
        },
        "terminal_hash": {
          "$ref": "#/$defs/hash"
        },
        "finalization_status": {
          "enum": [
            "committed",
            "failed",
            "not_applicable_qualification",
            "not_applicable_read_only",
            "missing"
          ]
        },
        "receipt_ref": {
          "$ref": "#/$defs/relativeRef"
        },
        "receipt_hash": {
          "$ref": "#/$defs/hash"
        },
        "disposition": {
          "enum": [
            "skipped",
            "passed",
            "failed",
            "unknown",
            "not_executed"
          ]
        },
        "missing_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "finalization_status": {
                "enum": [
                  "committed",
                  "failed"
                ]
              }
            }
          },
          "then": {
            "required": [
              "receipt_ref",
              "receipt_hash"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "finalization_status": {
                "enum": [
                  "not_applicable_qualification",
                  "not_applicable_read_only",
                  "missing"
                ]
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "receipt_ref"
                  ]
                },
                {
                  "required": [
                    "receipt_hash"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "finalization_status": {
                "const": "missing"
              }
            }
          },
          "then": {
            "properties": {
              "disposition": {
                "enum": [
                  "unknown",
                  "not_executed",
                  "skipped",
                  "failed"
                ]
              }
            }
          },
          "else": {
            "required": [
              "run_id",
              "terminal_ref",
              "terminal_hash"
            ]
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "terminal_ref"
              ]
            }
          },
          "then": {
            "required": [
              "missing_reason"
            ]
          }
        }
      ],
      "dependentRequired": {
        "terminal_hash": [
          "terminal_ref",
          "run_id"
        ],
        "terminal_ref": [
          "terminal_hash",
          "run_id"
        ]
      }
    }
  }
}
