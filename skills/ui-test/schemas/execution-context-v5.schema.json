{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ui-test/schemas/execution-context.schema.v5.json",
  "title": "Execution Context V5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "execution_origin",
    "origin_evidence",
    "run_id",
    "node_id",
    "case_id",
    "branch_id",
    "risk_level",
    "environment",
    "approved",
    "approval_source",
    "runner_digest",
    "project_config_digest",
    "finalization_policy_digest",
    "attempt_ref",
    "finalization_contract",
    "run_result_contract",
    "session_result_contract",
    "acceptance_contract",
    "config_summary",
    "execution_channel"
  ],
  "properties": {
    "binding": {"type":"object","required":["entry","source","sha256","node_id","dependencies","version"]},
    "schema_version": {
      "const": "ui-test.execution-context.v5"
    },
    "session_id": {
      "$ref": "#/$defs/stableIdentity"
    },
    "execution_origin": {
      "enum": [
        "pycharm",
        "codex-cli",
        "cli",
        "ci",
        "unknown"
      ]
    },
    "origin_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "evidence_digest"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "jetbrains-runner-path",
            "sys-argv",
            "ci-env",
            "explicit-cli-arg",
            "unknown"
          ]
        },
        "evidence_digest": {
          "$ref": "#/$defs/hash"
        },
        "runner_path_hash": {
          "$ref": "#/$defs/hash"
        },
        "runner_content_hash": {
          "$ref": "#/$defs/hash"
        },
        "argv0": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^(?:[A-Za-z]:|/|\\\\)"
          }
        },
        "invocation_marker": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(?i)(password|secret|token|cookie|authorization|api[_-]?key)"
          }
        }
      }
    },
    "run_id": {
      "$ref": "#/$defs/stableIdentity"
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "case_id": {
      "$ref": "#/$defs/stableIdentity"
    },
    "branch_id": {
      "$ref": "#/$defs/stableIdentity"
    },
    "risk_level": {
      "enum": [
        "r0-read-only",
        "r1-read-only-authenticated",
        "r2-ui-write-test",
        "r3-high-impact"
      ]
    },
    "environment": {
      "enum": [
        "public",
        "test",
        "staging",
        "production"
      ]
    },
    "approved": {
      "type": "boolean"
    },
    "approval_source": {
      "enum": [
        "explicit-cli",
        "pycharm-project-policy",
        "not-approved"
      ]
    },
    "runner_digest": {
      "$ref": "#/$defs/hash"
    },
    "project_config_digest": {
      "$ref": "#/$defs/hash"
    },
    "finalization_policy_digest": {
      "$ref": "#/$defs/hash"
    },
    "attempt_ref": {
      "$ref": "#/$defs/relativeRef"
    },
    "finalization_contract": {
      "const": "transaction-v1"
    },
    "run_result_contract": {
      "const": "v5"
    },
    "session_result_contract": {
      "const": "v2"
    },
    "acceptance_contract": {
      "const": "external-exit-v1"
    },
    "config_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_version",
        "origin_detection",
        "entry_scope",
        "r2_authorization",
        "run_scope",
        "finalization_contract",
        "run_result_contract",
        "session_result_contract",
        "acceptance_contract",
        "effective_concurrency"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "2.3",
            "2.4"
          ]
        },
        "contract_version": {
          "enum": [
            4,
            5
          ]
        },
        "origin_detection": {
          "const": "jetbrains-runner-path"
        },
        "entry_scope": {
          "const": "specified-runner"
        },
        "r2_authorization": {
          "const": "auto-test-only"
        },
        "run_scope": {
          "const": "per-node"
        },
        "finalization_contract": {
          "const": "transaction-v1"
        },
        "run_result_contract": {
          "const": "v5"
        },
        "session_result_contract": {
          "const": "v2"
        },
        "acceptance_contract": {
          "const": "external-exit-v1"
        },
        "stage_write_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "case_id",
            "branch_id",
            "phase_ids",
            "contract",
            "max_per_phase",
            "budget_hash"
          ],
          "properties": {
            "case_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,128}$"
            },
            "branch_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,128}$"
            },
            "phase_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,80}$"
              }
            },
            "contract": {
              "const": "stage-budget-v1"
            },
            "max_per_phase": {
              "const": 1
            },
            "budget_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "effective_concurrency": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "serial_constraints"
          ],
          "properties": {
            "source": {
              "enum": [
                "project-default",
                "project-user-decision",
                "legacy-template-default",
                "legacy-user-decision"
              ]
            },
            "serial_constraints": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scope",
                  "decision_ref"
                ],
                "properties": {
                  "scope": {
                    "enum": [
                      "nodes",
                      "project-environment"
                    ]
                  },
                  "decision_ref": {
                    "type": "string",
                    "pattern": "^\\S{1,512}$"
                  },
                  "node_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    }
                  }
                },
                "if": {
                  "properties": {
                    "scope": {
                      "const": "nodes"
                    }
                  }
                },
                "then": {
                  "required": [
                    "node_ids"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "node_ids"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "execution_channel": {
      "enum": [
        "single-process",
        "xdist-worker"
      ]
    },
    "task_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "batch_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "instruction_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_origin": {
            "const": "pycharm"
          }
        }
      },
      "then": {
        "properties": {
          "origin_evidence": {
            "required": [
              "runner_path_hash",
              "runner_content_hash"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stableIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "relativeRef": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^(?:[A-Za-z]:|/|\\\\)"
          },
          {
            "pattern": "(?:^|/)\\.\\.(?:/|$)"
          },
          {
            "pattern": "(?i)(password|secret|token|cookie|authorization|api[_-]?key)"
          }
        ]
      }
    }
  }
}
